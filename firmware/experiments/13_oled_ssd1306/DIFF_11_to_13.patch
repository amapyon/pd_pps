+                                  valid ? r.bus_raw : 0u,
+                                  valid ? r.shunt_raw : 0,
+                                  valid);
+    }
+    if (active_negotiation) return;
+    m2_dashboard_service(&s_m2_display, now);
+    if (s_m2_display.display_fault && !s_m2_fault_reported) {
+        s_m2_fault_reported = true;
